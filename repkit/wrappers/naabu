#!/usr/bin/env bash
# repkit wrapper for naabu (fast TCP port scanner)
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/../lib/engagement.sh"
source "$SCRIPT_DIR/../tool_defaults.conf"

OUTPUT_DIR=$(ensure_engagement_dir naabu) || exit 1
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
OUTFILE="$OUTPUT_DIR/naabu_${TIMESTAMP}.json"
RESUME_FILE="$OUTPUT_DIR/.naabu_resume.cfg"

ARGS=()
skip_next=0
for arg in "$@"; do
    if [[ $skip_next -eq 1 ]]; then skip_next=0; continue; fi
    case "$arg" in
        -o|-output|-resume) skip_next=1; continue ;;
    esac
    ARGS+=("$arg")
done

scope_guard "${ARGS[@]}" || exit 1

RESUME_ARGS=()
if [[ -f "$RESUME_FILE" ]]; then
    echo "[repkit] resuming from previous naabu run" >&2
    RESUME_ARGS=(-resume "$RESUME_FILE")
fi

echo "[repkit] naabu output -> $OUTFILE" >&2
audit_run naabu "$HOME/go/bin/naabu" "${NAABU_DEFAULTS[@]}" "${RESUME_ARGS[@]}" -json -o "$OUTFILE" "${ARGS[@]}"
rc=$?
[[ $rc -eq 0 ]] && rm -f "$RESUME_FILE"
exit $rc
