#!/usr/bin/env bash
# repkit wrapper for katana (headless web spider)
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/../lib/engagement.sh"
source "$SCRIPT_DIR/../tool_defaults.conf"

OUTPUT_DIR=$(ensure_engagement_dir katana) || exit 1
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
OUTFILE="$OUTPUT_DIR/katana_${TIMESTAMP}.jsonl"
RESUME_FILE="$OUTPUT_DIR/.katana_resume.cfg"

ARGS=()
skip_next=0
for arg in "$@"; do
    if [[ $skip_next -eq 1 ]]; then skip_next=0; continue; fi
    case "$arg" in
        -o|-output|-resume) skip_next=1; continue ;;
    esac
    ARGS+=("$arg")
done

scope_guard "${ARGS[@]}" || exit 1

[[ -f "$RESUME_FILE" ]] && echo "[repkit] resuming from previous katana run" >&2
echo "[repkit] katana output -> $OUTFILE" >&2
"$HOME/go/bin/katana" "${KATANA_DEFAULTS[@]}" -resume "$RESUME_FILE" -jsonl -o "$OUTFILE" "${ARGS[@]}"
rc=$?
[[ $rc -eq 0 ]] && rm -f "$RESUME_FILE"
exit $rc
