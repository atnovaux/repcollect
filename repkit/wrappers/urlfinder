#!/usr/bin/env bash
# repkit wrapper for urlfinder (passive URL discovery from archives)
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/../lib/engagement.sh"
source "$SCRIPT_DIR/../tool_defaults.conf"

OUTPUT_DIR=$(ensure_engagement_dir urlfinder) || exit 1
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
OUTFILE="$OUTPUT_DIR/urlfinder_${TIMESTAMP}.txt"

ARGS=()
skip_next=0
for arg in "$@"; do
    if [[ $skip_next -eq 1 ]]; then skip_next=0; continue; fi
    case "$arg" in
        -o|-output) skip_next=1; continue ;;
    esac
    ARGS+=("$arg")
done

# urlfinder hits passive archives (Wayback/CommonCrawl) — no direct target traffic.
echo "[repkit] urlfinder output -> $OUTFILE" >&2
"$HOME/go/bin/urlfinder" "${URLFINDER_DEFAULTS[@]}" -o "$OUTFILE" "${ARGS[@]}"
exit $?
