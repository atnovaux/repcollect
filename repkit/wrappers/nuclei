#!/usr/bin/env bash
# repkit wrapper for nuclei (active vuln scanner)
# - Forces JSONL output into the engagement dir
# - Applies NUCLEI_DEFAULTS from tool_defaults.conf
# - Resume via -resume statefile (auto-deleted on success)
# - scope_guard: rejects out-of-scope targets unless OPSEC_ALLOW_OUT_OF_SCOPE=1

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/../lib/engagement.sh"
source "$SCRIPT_DIR/../tool_defaults.conf"

OUTPUT_DIR=$(ensure_engagement_dir nuclei) || exit 1
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
OUTFILE="$OUTPUT_DIR/nuclei_${TIMESTAMP}.json"
RESUME_FILE="$OUTPUT_DIR/.nuclei_resume.cfg"

ARGS=()
skip_next=0
for arg in "$@"; do
    if [[ $skip_next -eq 1 ]]; then skip_next=0; continue; fi
    case "$arg" in
        -o|-output|-je|-json-export|-resume) skip_next=1; continue ;;
    esac
    ARGS+=("$arg")
done

scope_guard "${ARGS[@]}" || exit 1

# Self-heal: if templates dir is missing, fetch them now.
TEMPLATE_DIR="$HOME/nuclei-templates"
if [[ ! -d "$TEMPLATE_DIR" || -z "$(ls -A "$TEMPLATE_DIR" 2>/dev/null)" ]]; then
    echo "[repkit] nuclei templates missing — fetching with -ut (one-time, ~3 min)" >&2
    "$HOME/go/bin/nuclei" -ut -duc || {
        echo "error: nuclei -ut failed. run 'nuclei -ut' manually." >&2
        exit 1
    }
fi

RESUME_ARGS=()
if [[ -f "$RESUME_FILE" ]]; then
    echo "[repkit] resuming from previous nuclei run" >&2
    RESUME_ARGS=(-resume "$RESUME_FILE")
fi

echo "[repkit] nuclei output -> $OUTFILE" >&2
"$HOME/go/bin/nuclei" "${NUCLEI_DEFAULTS[@]}" "${RESUME_ARGS[@]}" -je "$OUTFILE" "${ARGS[@]}"
rc=$?
[[ $rc -eq 0 ]] && rm -f "$RESUME_FILE"
exit $rc
