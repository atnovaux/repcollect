#!/usr/bin/env bash
# repkit wrapper for dnsx (bulk DNS resolver / wildcard filter)
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/../lib/engagement.sh"
source "$SCRIPT_DIR/../tool_defaults.conf"

OUTPUT_DIR=$(ensure_engagement_dir dnsx) || exit 1
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
OUTFILE="$OUTPUT_DIR/dnsx_${TIMESTAMP}.json"

ARGS=()
skip_next=0
for arg in "$@"; do
    if [[ $skip_next -eq 1 ]]; then skip_next=0; continue; fi
    case "$arg" in
        -o|-output) skip_next=1; continue ;;
    esac
    ARGS+=("$arg")
done

# DNS resolution via public resolvers — no direct target traffic.
echo "[repkit] dnsx output -> $OUTFILE" >&2
audit_run dnsx "$HOME/go/bin/dnsx" "${DNSX_DEFAULTS[@]}" -json -o "$OUTFILE" "${ARGS[@]}"
exit $?
